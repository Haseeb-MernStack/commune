# ---- API ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/commune
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Where uploaded images are stored (relative to apps/api, or an absolute path)
UPLOAD_DIR=uploads

# Number of reverse proxies in front of the API (1 on a single host, 2 for Vercel -> Render)
TRUST_PROXY=1

# Optional: store images in Cloudinary instead of local disk (needed on Render's free plan).
# Leave blank for local development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: email for account verification and password reset (https://resend.com).
# Leave blank in development: emails are printed in the API log instead.
RESEND_API_KEY=
EMAIL_FROM=Commune <onboarding@resend.dev>
# Optional: paid posts through Lemon Squeezy (https://lemonsqueezy.com). With none of these set,
# development simulates purchases (nothing is charged) and production answers "not set up".
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Percent of every sale the platform keeps; the rest is credited to the post's author.
PLATFORM_FEE_PERCENT=20

# Set to true to require a verified email before posting, liking, commenting or following.
REQUIRE_VERIFIED_EMAIL=false

# Optional: "Sign in with Google". Create a Web OAuth client in Google Cloud Console and paste
# its client ID here AND in VITE_GOOGLE_CLIENT_ID below (the same value; it is public).
GOOGLE_CLIENT_ID=

# ---- Web ----
# Only needed for local development; production builds use "/api" automatically.
VITE_API_URL=http://localhost:4000/api

# Optional: Google sign-in button and AdSense ads (both are hidden when blank).
VITE_GOOGLE_CLIENT_ID=
# AdSense publisher id (ca-pub-...) and the ad unit id for the Explore feed. Production only.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_FEED_SLOT=

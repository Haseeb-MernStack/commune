# ---- API ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/commune
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Where uploaded images are stored (relative to apps/api, or an absolute path)
UPLOAD_DIR=uploads

# Number of reverse proxies in front of the API (1 on a single host, 2 for Vercel -> Render)
TRUST_PROXY=1

# Optional: store images in Cloudinary instead of local disk (needed on Render's free plan).
# Leave blank for local development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Web ----
# Only needed for local development; production builds use "/api" automatically.
VITE_API_URL=http://localhost:4000/api

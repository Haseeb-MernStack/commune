{
  "installCommand":"cd ../.. && npm install --include=dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://commune-8im5.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://commune-8im5.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
